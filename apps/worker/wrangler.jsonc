{
  // Servidor do ABC+ GAME (Cloudflare Workers + Durable Objects + D1).
  "name": "abc-game",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "LobbyObject" },
      { "name": "MATCH", "class_name": "MatchObject" },
      { "name": "QUIZ", "class_name": "QuizObject" }
    ]
  },
  "migrations": [
    // O plano Free só aceita Durable Objects com armazenamento SQLite.
    { "tag": "v1", "new_sqlite_classes": ["LobbyObject", "MatchObject"] },
    { "tag": "v2", "new_sqlite_classes": ["QuizObject"] }
  ],
  // Serve o site (apps/web/dist) pelo mesmo endereço da API: sem CORS e sem cobrar requisição
  // por arquivo estático. Só /api/* passa pelo código do Worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abc-game",
      "database_id": "11163c78-ad4f-49e2-9526-e5b6c1e2fd50",
      "migrations_dir": "migrations"
    }
  ]
}
