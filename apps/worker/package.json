{
  "name": "@abc-game/worker",
  "private": true,
  "version": "0.0.0",
  "description": "API e partidas na Cloudflare (Workers, Durable Objects, D1)",
  "type": "module",
  "scripts": {
    "bank:dev": "node ../../scripts/gerar-banco.mjs --dev",
    "bank:prod": "node ../../scripts/gerar-banco.mjs",
    "db:local": "wrangler d1 migrations apply abc-game --local",
    "db:remote": "wrangler d1 migrations apply abc-game --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "e2e:quiz": "node scripts/e2e-quiz.mjs",
    "e2e:ranking": "node scripts/e2e-ranking.mjs",
    "e2e:link": "node scripts/e2e-link.mjs",
    "e2e:rematch": "node scripts/e2e-rematch.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@abc-game/domain": "*",
    "@abc-game/protocol": "*"
  }
}
